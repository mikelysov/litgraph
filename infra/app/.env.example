# Choose ONE of these:
# Local Redis when running compose profile 'redis-local'
REDIS_URL=redis://redis:6379/0
# Or Upstash for prod-like tests (don’t run the local redis service)
# REDIS_URL=rediss://:<token>@<upstash-host>:<port>

RUST_LOG=info

# ArcadeDB (graph + vector, one DB)
ARCADEDB_URI=bolt://arcadedb:7687
ARCADEDB_HTTP_URL=http://arcadedb:2480
ARCADEDB_DATABASE=litrag
ARCADEDB_USER=root
ARCADEDB_PASSWORD=change-me
