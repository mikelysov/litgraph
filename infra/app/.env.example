# Choose ONE of these:
# Local Redis when running compose profile 'redis-local'
REDIS_URL=redis://redis:6379/0
# Or Upstash for prod-like tests (don’t run the local redis service)
# REDIS_URL=rediss://:<token>@<upstash-host>:<port>

RUST_LOG=info

# Neo4j graph (host gateway for docker)
# Bolt on host port 7787 (7687 + 100); container litgraph-neo4j maps 7787->7687.
# Gateway IP = docker bridge of litgraph-local_default; check `docker network inspect litgraph-local_default`.
NEO4J_URI=bolt://172.18.0.1:7787
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
