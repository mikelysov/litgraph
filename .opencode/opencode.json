{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "instructions": [
    ".opencode/rules/karpathy-guidelines.mdc"
  ],
  "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI",
      "options": {
        "baseURL": "https://routerai.ru/api/v1"
      },
      "models": {
        "qwen/qwen3.7-max": {"name": "Qwen3.7 Max"},
        "qwen/qwen3.7-plus": {"name": "Qwen3.7 Plus"},
        "z-ai/glm-5.2": {"name": "GLM 5.2"},
        "minimax/minimax-m3": {"name": "MiniMax M3.0"},
        "xiaomi/mimo-v2.5-pro": {"name": "MiMo-V2.5-Pro"},
        "xiaomi/mimo-v2.5": {"name": "MiMo-V2.5"},
        "deepseek/deepseek-v4-pro": {"name": "DeepSeek V4 Pro"},
        "deepseek/deepseek-v4-flash": {"name": "DeepSeek V4 Flash"},
        "x-ai/grok-4.5": {"name": "xAI: Grok 4.5"}
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM-Studio",
      "options": {"baseURL": "http://172.31.61.121:1234/v1"},
      "models": {
        "gemma-4-31b-it-qat": {"name": "gemma-4-31b-it-qat"}
      }
    }
  },
  "mcp": {
    "web-search": {
      "type": "local",
      "command": [
        "node",
        "/mnt/d/colab/agents/web-search-mcp/dist/index.js"
      ],
      "enabled": true
    }
  },
  "mode": {
    "plan": {"temperature": 0.1},
    "build": {"temperature": 0.1},
    "brainstorm": {"temperature": 1}
  }
}
