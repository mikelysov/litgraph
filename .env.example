# Use Qdrant locally
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Or switch to Fly.io
# QDRANT_HOST=qdrant-litgraph.fly.dev
# QDRANT_PORT=6333
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://redis:6379/0

# Embedding: local (SentenceTransformer) or remote (OpenAI-compatible API)
# Leave EMBEDDING_API_URL empty for local SentenceTransformer model
# EMBEDDING_API_URL=http://172.31.61.121:1234/v1
# EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b@q8_0
EMBEDDING_MODEL_PATH=/mnt/d/colab/llms/bge-m3
EMBEDDING_DIM=1024
MCP_PORT=8888